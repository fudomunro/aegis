# Immich starter .env for Aegis setup (issue #121)
#
# How to use (first-time install) — write THIS file BEFORE the first `up`:
#   1. mkdir immich-app && cd immich-app
#   2. curl -fsSL -o docker-compose.yml \
#        https://github.com/immich-app/immich/releases/latest/download/docker-compose.yml
#   3. Save THIS file as ./.env   (must be named .env — not example.env)
#   4. docker compose up -d
#   5. Wait until `docker compose ps` shows immich_server as healthy (often 30–90s)
#   6. Open http://localhost:2283 and register the first (admin) account
#
# If compose warns "The UPLOAD_LOCATION variable is not set", the file is
# missing or still named example.env. You do not need to edit values below
# for a single-machine test install.
#
# If http://localhost:2283 is ERR_CONNECTION_REFUSED after `up -d`:
#   docker compose ps
#   docker compose logs --tail=50 immich-server
#   docker compose logs --tail=20 database
# Common cause: Postgres was initialized without DB_DATABASE_NAME, so the
# server restart-loops with `database "immich" does not exist`. Fix on a
# throwaway install: create the DB (`docker exec immich_postgres psql -U
# postgres -c 'CREATE DATABASE immich;'`) and `docker compose restart
# immich-server`, or wipe ./postgres and `docker compose up -d` again.

# Where Immich stores uploaded photos/videos (your library). Relative to the
# compose directory. Use a path with plenty of free space; not a network share.
UPLOAD_LOCATION=./library

# Where Immich stores the Postgres database files (metadata only, not photos).
# Must be local disk — network shares are not supported for the database.
DB_DATA_LOCATION=./postgres

# Timezone for photo timestamps / jobs. Uncomment and set if your server is not UTC.
# See https://en.wikipedia.org/wiki/List_of_tz_database_time_zones#List
# TZ=America/Los_Angeles

# Immich release to run. Pin a version when you upgrade deliberately.
IMMICH_VERSION=v3

# Local Postgres password used only between Immich and its own database.
# Change it if you like — letters+digits only (no spaces/special chars).
# Not your Immich login password and not exposed outside Docker.
DB_PASSWORD=postgres

# Postgres user / database created on first start. Defaults are fine for a new install.
# NOTE: the database name is only created when the Postgres data directory is
# first initialized — put this file in place before the first `docker compose up`.
DB_USERNAME=postgres
DB_DATABASE_NAME=immich
