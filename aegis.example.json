{
  "connections": {
    "google": {
      "name": "Google",
      "client_id": "YOUR_GOOGLE_CLIENT_ID",
      "client_secret": "$ENV:GOOGLE_CLIENT_SECRET",
      "auth_url": "https://accounts.google.com/o/oauth2/v2/auth",
      "token_url": "https://oauth2.googleapis.com/token",
      "scopes": [
        "https://www.googleapis.com/auth/youtube.readonly",
        "https://www.googleapis.com/auth/photospicker.mediaitems.readonly",
        "https://www.googleapis.com/auth/contacts.readonly",
        "https://www.googleapis.com/auth/calendar.readonly",
        "https://www.googleapis.com/auth/gmail.readonly"
      ]
    },
    "spotify": {
      "name": "Spotify",
      "client_id": "YOUR_SPOTIFY_CLIENT_ID",
      "client_secret": "$ENV:SPOTIFY_CLIENT_SECRET",
      "auth_url": "https://accounts.spotify.com/authorize",
      "token_url": "https://accounts.spotify.com/api/token",
      "scopes": [
        "user-read-playback-state",
        "user-library-read",
        "user-follow-read",
        "playlist-read-private",
        "playlist-read-collaborative"
      ]
    },
    "amazon": {
      "name": "Amazon",
      "client_id": "YOUR_LWA_CLIENT_ID",
      "client_secret": "$ENV:AMAZON_CLIENT_SECRET",
      "auth_url": "https://www.amazon.com/ap/oa",
      "token_url": "https://api.amazon.com/auth/o2/token",
      "scopes": [
        "music:user_profile"
      ]
    }
  },
  "data_grants": {
    "tracks": {
      "default": "read",
      "providers": {
        "spotify": "read"
      }
    },
    "playlists": {
      "default": "read"
    },
    "player": {
      "default": "none"
    },
    "recommendations": {
      "default": "none"
    },
    "places": {
      "default": "none",
      "providers": {
        "google-timeline": "city"
      }
    },
    "events": {
      "default": "read"
    },
    "transactions": {
      "default": "read"
    }
  },
  "services": [
    {
      "id": "spotify",
      "name": "Spotify",
      "aliases": [
        "spotify music"
      ],
      "action": "inject",
      "endpoint": "https://api.spotify.com/v1",
      "cache_ttl": "10m",
      "description": "Lists Spotify playlists, liked tracks, albums, and artists into /v1/library/*. Full playlist items via content transport /v1/services/spotify/playlists/{id}/items.",
      "canonical_for": [
        "playlists",
        "tracks"
      ],
      "connection": "spotify",
      "grant_limits": {
        "default": "read",
        "playlists": "read",
        "tracks": "read",
        "player": "none",
        "recommendations": "none"
      }
    },
    {
      "id": "youtube-music",
      "name": "YouTube Music",
      "aliases": [
        "yt music",
        "ytmusic"
      ],
      "action": "inject",
      "endpoint": "https://www.googleapis.com/youtube/v3",
      "cache_ttl": "15m",
      "connection": "google",
      "oauth_scopes": [
        "https://www.googleapis.com/auth/youtube.readonly"
      ],
      "grant_limits": {
        "default": "read"
      },
      "description": "Lists YouTube Music playlists and liked videos into /v1/library/*. Playlist items via content transport. Shares the Google connection."
    },
    {
      "id": "amazon-music",
      "name": "Amazon Music",
      "aliases": [
        "amazon music unlimited"
      ],
      "action": "inject",
      "endpoint": "https://api.amazonmusic.com/v1",
      "cache_ttl": "15m",
      "description": "Lists Amazon Music playlists into /v1/library/playlists. Full playlist items via content transport.",
      "connection": "amazon"
    },
    {
      "id": "tidal",
      "name": "Tidal",
      "action": "block",
      "description": "Tidal access is not permitted in this environment"
    },
    {
      "id": "google-photos",
      "name": "Google Photos",
      "aliases": [
        "photos",
        "photo",
        "pictures",
        "picture",
        "google photos library"
      ],
      "action": "inject",
      "endpoint": "https://photospicker.googleapis.com/v1",
      "cache_ttl": "15m",
      "description": "Google Photos via the Picker API: the user selects photos once; Aegis lists that selection as neutral metadata. Photo bytes stay on Google Photos (non-Aegis canonical). Shares the Google connection with YouTube and Contacts.",
      "canonical_for": [
        "photos"
      ],
      "connection": "google",
      "oauth_scopes": [
        "https://www.googleapis.com/auth/photospicker.mediaitems.readonly"
      ],
      "grant_limits": {
        "default": "read",
        "photos": "read"
      }
    },
    {
      "id": "immich",
      "name": "Immich",
      "aliases": [
        "immich photos",
        "self-hosted photos",
        "immich",
        "photo",
        "photos",
        "pictures",
        "picture",
        "photo library"
      ],
      "action": "inject",
      "endpoint": "http://192.168.1.10:2283/api",
      "headers": {
        "X-API-Key": "$ENV:IMMICH_API_KEY"
      },
      "cache_ttl": "5m",
      "description": "Self-hosted Immich photo library. Photo bytes stay on Immich (foreign/local canonical). Set canonical_for: [\"photos\"] here if Immich is your home copy (and remove it from google-photos).",
      "grant_limits": {
        "default": "read",
        "photos": "read"
      }
    },
    {
      "id": "google",
      "name": "Google Contacts",
      "aliases": [
        "google contacts",
        "contacts",
        "address book"
      ],
      "action": "inject",
      "endpoint": "https://people.googleapis.com/v1",
      "cache_ttl": "15m",
      "description": "Lists Google People/Contacts address-book entries as neutral contacts so photo.people[] and other types can share identity matching. Shares the Google connection.",
      "canonical_for": [
        "contacts"
      ],
      "connection": "google",
      "oauth_scopes": [
        "https://www.googleapis.com/auth/contacts.readonly"
      ],
      "grant_limits": {
        "default": "read",
        "contacts": "read"
      }
    },
    {
      "id": "google-calendar",
      "name": "Google Calendar",
      "aliases": [
        "google calendar",
        "calendar",
        "my calendar"
      ],
      "action": "inject",
      "endpoint": "https://www.googleapis.com/calendar/v3",
      "cache_ttl": "5m",
      "description": "Lists Google Calendar events as neutral calendar entries so /v1/library/events can answer schedule questions. Event content stays on Google Calendar (non-Aegis canonical). Shares the Google connection.",
      "canonical_for": [
        "events"
      ],
      "connection": "google",
      "oauth_scopes": [
        "https://www.googleapis.com/auth/calendar.readonly"
      ],
      "grant_limits": {
        "default": "read",
        "events": "read"
      }
    },
    {
      "id": "google-gmail",
      "name": "Gmail",
      "aliases": [
        "gmail",
        "email",
        "google mail",
        "my inbox"
      ],
      "action": "inject",
      "endpoint": "https://gmail.googleapis.com/gmail/v1",
      "cache_ttl": "5m",
      "description": "Lists Gmail messages as neutral message metadata so /v1/library/messages can answer email questions. Message bodies stay on Gmail (non-Aegis canonical). Shares the Google connection.",
      "canonical_for": [
        "messages"
      ],
      "connection": "google",
      "oauth_scopes": [
        "https://www.googleapis.com/auth/gmail.readonly"
      ],
      "grant_limits": {
        "default": "read",
        "messages": "read"
      }
    },
    {
      "id": "ynab",
      "name": "YNAB",
      "aliases": [
        "ynab",
        "you need a budget",
        "budget"
      ],
      "action": "inject",
      "endpoint": "https://api.ynab.com/v1",
      "headers": {
        "Authorization": "Bearer $ENV:YNAB_PERSONAL_ACCESS_TOKEN"
      },
      "cache_ttl": "5m",
      "description": "Live YNAB budget transactions for /v1/library/transactions. Prefer a Personal Access Token in headers (Aegis owns the secret). Amounts map from milliunits to signed decimal strings.",
      "grant_limits": {
        "default": "read",
        "transactions": "read"
      }
    },
    {
      "id": "quicken",
      "name": "Quicken",
      "aliases": [
        "quicken",
        "qif",
        "qfx",
        "ofx",
        "bank export"
      ],
      "action": "inject",
      "description": "Locally imported Quicken QIF/QFX files. Import with -import-quicken or POST /v1/services/quicken/import. Line-item metadata only \u2014 statements/PDFs are never stored.",
      "grant_limits": {
        "default": "read",
        "transactions": "read"
      }
    },
    {
      "id": "bluesky",
      "name": "Bluesky",
      "aliases": [
        "bluesky",
        "bsky",
        "atproto",
        "share photos"
      ],
      "action": "inject",
      "endpoint": "https://bsky.social",
      "headers": {
        "X-Bluesky-Handle": "$ENV:BLUESKY_HANDLE",
        "X-Bluesky-App-Password": "$ENV:BLUESKY_APP_PASSWORD"
      },
      "cache_ttl": "5m",
      "description": "Share photos to Bluesky as public image posts (ownership-claim PoC, issue #20). Aegis stores no photo bytes; it fetches from the canonical photo service, posts a copy, and returns a sha256 + post_uri claim. Image embeds cap at 1MB. Use an app password, not your main password.",
      "grant_limits": {
        "default": "read",
        "photos": "write"
      }
    }
  ]
}
