{
  "services": [
    {
      "id": "spotify",
      "name": "Spotify",
      "aliases": ["spotify music"],
      "action": "inject",
      "endpoint": "https://api.internal.example.com/spotify/context",
      "headers": {
        "Authorization": "Bearer ${SPOTIFY_CONTEXT_TOKEN}"
      },
      "cache_ttl": "10m",
      "description": "Injects user library and playlist context when agents work with Spotify"
    },
    {
      "id": "youtube-music",
      "name": "YouTube Music",
      "aliases": ["yt music", "ytmusic"],
      "action": "inject",
      "endpoint": "https://api.internal.example.com/youtube-music/context",
      "cache_ttl": "15m",
      "description": "Injects YouTube Music library context"
    },
    {
      "id": "amazon-music",
      "name": "Amazon Music",
      "aliases": ["amazon music unlimited"],
      "action": "inject",
      "endpoint": "https://api.internal.example.com/amazon-music/context",
      "cache_ttl": "15m",
      "description": "Injects Amazon Music library context"
    },
    {
      "id": "tidal",
      "name": "Tidal",
      "action": "block",
      "description": "Tidal access is not permitted in this environment"
    }
  ]
}
