{
  "connections": {
    "google": {
      "name": "Google",
      "client_id": "YOUR_GOOGLE_CLIENT_ID",
      "client_secret": "YOUR_GOOGLE_CLIENT_SECRET",
      "auth_url": "https://accounts.google.com/o/oauth2/v2/auth",
      "token_url": "https://oauth2.googleapis.com/token",
      "scopes": [
        "https://www.googleapis.com/auth/youtube.readonly",
        "https://www.googleapis.com/auth/photospicker.mediaitems.readonly",
        "https://www.googleapis.com/auth/contacts.readonly",
        "https://www.googleapis.com/auth/calendar.readonly",
        "https://www.googleapis.com/auth/gmail.readonly"
      ]
    },
    "spotify": {
      "name": "Spotify",
      "client_id": "YOUR_SPOTIFY_CLIENT_ID",
      "client_secret": "YOUR_SPOTIFY_CLIENT_SECRET",
      "auth_url": "https://accounts.spotify.com/authorize",
      "token_url": "https://accounts.spotify.com/api/token",
      "scopes": [
        "user-read-playback-state",
        "user-library-read",
        "user-follow-read",
        "playlist-read-private",
        "playlist-read-collaborative"
      ]
    },
    "amazon": {
      "name": "Amazon",
      "client_id": "YOUR_LWA_CLIENT_ID",
      "client_secret": "YOUR_LWA_CLIENT_SECRET",
      "auth_url": "https://www.amazon.com/ap/oa",
      "token_url": "https://api.amazon.com/auth/o2/token",
      "scopes": [
        "music:user_profile"
      ]
    }
  },
  "services": [
    {
      "id": "spotify",
      "name": "Spotify",
      "aliases": ["spotify music"],
      "action": "inject",
      "endpoint": "https://api.spotify.com/v1",
      "cache_ttl": "10m",
      "description": "Proxies Spotify API calls through Guardian for caching and auditing",
      "canonical_for": ["playlists", "tracks"],
      "connection": "spotify",
      "permissions": {
        "default": "read",
        "playlists": "read",
        "tracks": "read",
        "player": "none",
        "recommendations": "none"
      }
    },
    {
      "id": "youtube-music",
      "name": "YouTube Music",
      "aliases": ["yt music", "ytmusic"],
      "action": "inject",
      "endpoint": "https://www.googleapis.com/youtube/v3",
      "cache_ttl": "15m",
      "connection": "google",
      "oauth_scopes": [
        "https://www.googleapis.com/auth/youtube.readonly"
      ],
      "permissions": {
        "default": "read"
      },
      "description": "Proxies YouTube Music API calls through Guardian (shares the Google connection)"
    },
    {
      "id": "amazon-music",
      "name": "Amazon Music",
      "aliases": ["amazon music unlimited"],
      "action": "inject",
      "endpoint": "https://api.amazonmusic.com/v1",
      "cache_ttl": "15m",
      "description": "Proxies Amazon Music API calls through Guardian",
      "connection": "amazon"
    },
    {
      "id": "tidal",
      "name": "Tidal",
      "action": "block",
      "description": "Tidal access is not permitted in this environment"
    },
    {
      "id": "google-photos",
      "name": "Google Photos",
      "aliases": ["photos", "google photos library"],
      "action": "inject",
      "endpoint": "https://photospicker.googleapis.com/v1",
      "cache_ttl": "15m",
      "description": "Google Photos via the Picker API: the user selects photos once; Guardian lists that selection as neutral metadata. Photo bytes stay on Google Photos (non-Guardian canonical). Shares the Google connection with YouTube and Contacts.",
      "canonical_for": ["photos"],
      "connection": "google",
      "oauth_scopes": [
        "https://www.googleapis.com/auth/photospicker.mediaitems.readonly"
      ],
      "permissions": {
        "default": "read",
        "photos": "read"
      }
    },
    {
      "id": "immich",
      "name": "Immich",
      "aliases": ["immich photos", "self-hosted photos"],
      "action": "inject",
      "endpoint": "http://192.168.1.10:2283/api",
      "headers": {
        "X-API-Key": "YOUR_IMMICH_API_KEY"
      },
      "cache_ttl": "5m",
      "description": "Self-hosted Immich photo library. Photo bytes stay on Immich (foreign/local canonical). Set canonical_for: [\"photos\"] here if Immich is your home copy (and remove it from google-photos).",
      "permissions": {
        "default": "read",
        "photos": "read"
      }
    },
    {
      "id": "google",
      "name": "Google Contacts",
      "aliases": ["google contacts", "contacts", "address book"],
      "action": "inject",
      "endpoint": "https://people.googleapis.com/v1",
      "cache_ttl": "15m",
      "description": "Lists Google People/Contacts address-book entries as neutral contacts so photo.people[] and other types can share identity matching. Shares the Google connection.",
      "canonical_for": ["contacts"],
      "connection": "google",
      "oauth_scopes": [
        "https://www.googleapis.com/auth/contacts.readonly"
      ],
      "permissions": {
        "default": "read",
        "contacts": "read"
      }
    },
    {
      "id": "google-calendar",
      "name": "Google Calendar",
      "aliases": ["google calendar", "calendar", "my calendar"],
      "action": "inject",
      "endpoint": "https://www.googleapis.com/calendar/v3",
      "cache_ttl": "5m",
      "description": "Lists Google Calendar events as neutral calendar entries so /v1/library/events can answer schedule questions. Event content stays on Google Calendar (non-Guardian canonical). Shares the Google connection.",
      "canonical_for": ["events"],
      "connection": "google",
      "oauth_scopes": [
        "https://www.googleapis.com/auth/calendar.readonly"
      ],
      "permissions": {
        "default": "read",
        "events": "read"
      }
    },
    {
      "id": "google-gmail",
      "name": "Gmail",
      "aliases": ["gmail", "email", "google mail", "my inbox"],
      "action": "inject",
      "endpoint": "https://gmail.googleapis.com/gmail/v1",
      "cache_ttl": "5m",
      "description": "Lists Gmail messages as neutral message metadata so /v1/library/messages can answer email questions. Message bodies stay on Gmail (non-Guardian canonical). Shares the Google connection.",
      "canonical_for": ["messages"],
      "connection": "google",
      "oauth_scopes": [
        "https://www.googleapis.com/auth/gmail.readonly"
      ],
      "permissions": {
        "default": "read",
        "messages": "read"
      }
    }
  ]
}
