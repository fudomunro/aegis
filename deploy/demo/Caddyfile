# Aegis public demo — Caddy reverse proxy.
# Replace demo.example.com. Port 8090 is the local aegis-demo unit only.

demo.example.com {
	encode gzip

	# Mild abuse dampening for a shared alpha key.
	rate_limit {
		zone demo_rl {
			key    {remote_host}
			events 60
			period 1m
		}
	}

	reverse_proxy 127.0.0.1:8090 {
		header_up X-Forwarded-Proto {scheme}
	}

	# No caching of API responses; names may differ per persona.
	header /v1/* Cache-Control "no-store"

	log {
		output file /var/log/caddy/demo.access.log
	}
}
