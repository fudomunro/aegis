# Optional IP-only TLS fallback (self-signed) while DNS/certs settle.
# Install alongside aegis-demo.nginx; remove once the hostname is stable.

server {
    listen 8443 ssl;
    listen [::]:8443 ssl;
    server_name 138.197.8.215 _;

    ssl_certificate     /etc/ssl/aegis-demo/fullchain.pem;
    ssl_certificate_key /etc/ssl/aegis-demo/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    location / {
        proxy_pass http://127.0.0.1:8090;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 60s;
    }
}
